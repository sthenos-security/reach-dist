// Copyright © 2026 Sthenos Security. All rights reserved.
// REACHABLE Universal Security Scan — Jenkinsfile
//
// Single stage. REACHABLE runs all scanners concurrently in one process.
// Works on any Jenkins agent — no shared volumes, no coordination needed.
//
// ── Setup ─────────────────────────────────────────────────────────────
//   1. Create a Pipeline job → Script Path: Jenkinsfile
//   2. Optionally set REACHABLE_DIST_REPO, REACHABLE_VERSION, FAIL_THRESHOLD
//      as Jenkins environment variables or repo vars to override defaults.
//
// ── Exit codes ────────────────────────────────────────────────────────
//   0 = clean, 2 = findings above threshold, 1 = scan error

pipeline {

    agent any  // Replace with: agent { label 'your-runner' }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        REACHABLE_DIST_REPO = 'sthenos-security/reach-dist'
        REACHABLE_VERSION   = ''       // leave empty for latest
        FAIL_THRESHOLD      = 'high'   // critical | high | medium | any | none
    }

    stages {

        stage('Install REACHABLE') {
            steps {
                sh '''
                    ARGS=""
                    [ -n "${REACHABLE_VERSION}" ] && ARGS="--version ${REACHABLE_VERSION}"
                    curl -fsSL "https://raw.githubusercontent.com/${REACHABLE_DIST_REPO}/main/install.sh" | bash -s -- $ARGS
                    reachctl version
                '''
            }
        }

        stage('Scan') {
            steps {
                script {
                    def result = sh(
                        script: 'reachctl scan . --ci --fail-on "$FAIL_THRESHOLD" --sarif reachable.sarif; echo $?',
                        returnStdout: true
                    ).trim()
                    def exitCode = result.split('\n').last().trim()
                    env.SCAN_EXIT = exitCode
                    if (exitCode == '2') {
                        unstable("REACHABLE: findings above threshold '${env.FAIL_THRESHOLD}'")
                    } else if (exitCode != '0') {
                        error("REACHABLE: scan failed (exit ${exitCode})")
                    }
                }
            }
        }
    }

    post {
        always {
            sh "mkdir -p build/dashboard && find \${HOME}/.reachable/scans -type d -name dashboard -exec cp -r {}/ build/dashboard/ \\; 2>/dev/null || true"
            archiveArtifacts artifacts: 'build/dashboard/**', allowEmptyArchive: true
            archiveArtifacts artifacts: 'reachable.sarif', allowEmptyArchive: true
            def status = env.SCAN_EXIT == '0' ? '✅ Clean'
                       : env.SCAN_EXIT == '2' ? '⚠ Findings'
                                              : '❌ Error'
            currentBuild.description = status
        }
        success  { echo "REACHABLE: clean" }
        unstable { echo "REACHABLE: findings above threshold (${FAIL_THRESHOLD})" }
        failure  { echo "REACHABLE: scan error — check logs" }
    }
}
